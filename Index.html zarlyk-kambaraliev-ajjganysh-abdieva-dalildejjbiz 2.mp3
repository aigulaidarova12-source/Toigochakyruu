<!DOCTYPE html>
<html lang="ky">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f8f1e9" />

  <title>Азамат & Элиза | Үйлөнүү тою</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Georgia", "Times New Roman", serif;
      background: #f8f1e9;
      color: #4c4039;
      overflow-x: hidden;
    }

    button,
    input,
    textarea {
      font: inherit;
    }

    /* =========================
       LOADING / ENVELOPE
    ========================= */

    .intro {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: #f8f1e9;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 1s ease, visibility 1s ease;
    }

    .intro.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .envelope-wrap {
      width: min(90vw, 420px);
      text-align: center;
    }

    .envelope {
      position: relative;
      width: 100%;
      aspect-ratio: 1.5 / 1;
      cursor: pointer;
      perspective: 900px;
      filter: drop-shadow(0 18px 25px rgba(95, 73, 57, .13));
    }

    .envelope-back {
      position: absolute;
      inset: 0;
      background: #eadbc9;
      border-radius: 4px;
    }

    .envelope-back::before,
    .envelope-back::after {
      content: "";
      position: absolute;
      bottom: 0;
      width: 0;
      height: 0;
      border-style: solid;
      z-index: 3;
    }

    .envelope-back::before {
      left: 0;
      border-width: 0 0 100% 50%;
      border-color: transparent transparent #dfcbb7 transparent;
    }

    .envelope-back::after {
      right: 0;
      border-width: 100% 0 0 50%;
      border-color: transparent transparent transparent #dfcbb7;
    }

    .flap {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 65%;
      background: #e7d5c2;
      clip-path: polygon(0 0, 100% 0, 50% 100%);
      transform-origin: top center;
      transition: transform 1s cubic-bezier(.77, 0, .18, 1);
      z-index: 5;
    }

    .envelope.open .flap {
      transform: rotateX(180deg);
      z-index: 1;
    }

    .letter {
      position: absolute;
      left: 7%;
      bottom: 7%;
      width: 86%;
      height: 85%;
      background: #fffdf9;
      z-index: 2;
      padding: 25px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 1.1s cubic-bezier(.77, 0, .18, 1);
    }

    .envelope.open .letter {
      transform: translateY(-42%);
    }

    .letter-content {
      border: 1px solid #eadfd4;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
    }

    .letter-small {
      font-size: 11px;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: #9b8170;
      margin-bottom: 10px;
    }

    .letter-names {
      font-size: clamp(24px, 7vw, 38px);
      color: #665246;
    }

    .intro-text {
      margin-top: 32px;
      color: #806b5c;
      letter-spacing: 1px;
      font-size: 14px;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      50% {
        opacity: .45;
      }
    }

    /* =========================
       FLOWERS
    ========================= */

    .flower {
      position: absolute;
      pointer-events: none;
      opacity: .75;
      z-index: 2;
    }

    .flower span {
      display: block;
      width: 7px;
      height: 34px;
      border-radius: 100% 0;
      border: 1px solid rgba(157, 123, 98, .5);
      transform: rotate(38deg);
    }

    .flower.top-left {
      top: 15px;
      left: 15px;
      transform: rotate(-20deg);
    }

    .flower.top-right {
      top: 15px;
      right: 15px;
      transform: rotate(110deg);
    }

    .flower.bottom-left {
      bottom: 15px;
      left: 15px;
      transform: rotate(90deg);
    }

    .flower.bottom-right {
      bottom: 15px;
      right: 15px;
      transform: rotate(-100deg);
    }

    /* =========================
       MAIN
    ========================= */

    main {
      opacity: 0;
      transition: opacity 1.5s ease;
    }

    main.visible {
      opacity: 1;
    }

    section {
      position: relative;
      padding: 90px 22px;
      overflow: hidden;
    }

    .container {
      width: min(100%, 1050px);
      margin: auto;
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      background:
        radial-gradient(circle at 20% 20%, rgba(255,255,255,.8), transparent 30%),
        radial-gradient(circle at 80% 80%, rgba(226,205,185,.25), transparent 35%),
        #f8f1e9;
    }

    .hero-inner {
      max-width: 850px;
    }

    .eyebrow {
      font-size: 12px;
      letter-spacing: 5px;
      text-transform: uppercase;
      color: #a18470;
      margin-bottom: 22px;
    }

    .hero h1 {
      font-size: clamp(58px, 12vw, 125px);
      font-weight: 400;
      line-height: .9;
      color: #58483e;
      letter-spacing: -4px;
    }

    .hero h1 span {
      display: block;
      font-family: cursive;
      font-size: .55em;
      color: #9d7d68;
      margin: 10px 0;
      letter-spacing: 0;
    }

    .hero-date {
      margin-top: 34px;
      font-size: 15px;
      letter-spacing: 4px;
      color: #846c5c;
    }

    .scroll-down {
      margin-top: 55px;
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      color: #9b8271;
      font-size: 11px;
      letter-spacing: 2px;
    }

    .scroll-line {
      width: 1px;
      height: 55px;
      background: #bca593;
      animation: scrollLine 2s infinite;
    }

    @keyframes scrollLine {
      0%,100% { transform: scaleY(.4); transform-origin: top; }
      50% { transform: scaleY(1); transform-origin: top; }
    }

    /* =========================
       PHOTO
    ========================= */

    .photo-section {
      background: #fffaf5;
    }

    .photo-frame {
      max-width: 650px;
      height: 720px;
      margin: auto;
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(145deg, #dfd0c2, #f8eee5);
    }

    .photo-frame::after {
      content: "А & Э";
      position: absolute;
      bottom: 25px;
      right: 25px;
      color: rgba(255,255,255,.85);
      font-size: 28px;
      font-style: italic;
    }

    /*
      Бул жерде өзүңдүн сүрөтүңдү коюу үчүн:
      background-image: url("couple.jpg");
    */

    .photo-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 30px;
      color: #806d60;
      background:
        linear-gradient(rgba(255,255,255,.08), rgba(255,255,255,.08)),
        radial-gradient(circle at 50% 35%, #eee0d2 0 12%, transparent 12.5%),
        linear-gradient(160deg, #ddcbb9, #f7eee6);
    }

    .photo-placeholder div {
      border: 1px solid rgba(128,109,96,.35);
      padding: 30px;
      background: rgba(255,255,255,.25);
      backdrop-filter: blur(4px);
    }

    /* =========================
       MESSAGE
    ========================= */

    .message {
      text-align: center;
      background: #f8f1e9;
    }

    .ornament {
      color: #a48774;
      font-size: 28px;
      margin-bottom: 25px;
    }

    .message h2 {
      font-size: clamp(32px, 7vw, 58px);
      font-weight: 400;
      margin-bottom: 28px;
      color: #5d4b40;
    }

    .message p {
      max-width: 700px;
      margin: auto;
      font-size: 17px;
      line-height: 2;
      color: #746257;
    }

    /* =========================
       DATE / LOCATION
    ========================= */

    .details {
      background: #fffaf5;
    }

    .section-title {
      text-align: center;
      font-size: clamp(34px, 7vw, 58px);
      font-weight: 400;
      color: #5e4c41;
      margin-bottom: 60px;
    }

    .details-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
      max-width: 850px;
      margin: auto;
    }

    .detail-card {
      padding: 45px 25px;
      text-align: center;
      border: 1px solid #eaded2;
      background: rgba(255,255,255,.5);
    }

    .detail-icon {
      font-size: 27px;
      margin-bottom: 20px;
      color: #a18370;
    }

    .detail-card h3 {
      font-size: 13px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #927765;
      margin-bottom: 18px;
    }

    .detail-card p {
      font-size: 21px;
      line-height: 1.6;
      color: #5c4b40;
    }

    /* =========================
       PROGRAM
    ========================= */

    .program {
      background: #f4ebe2;
    }

    .timeline {
      max-width: 700px;
      margin: auto;
    }

    .timeline-item {
      display: grid;
      grid-template-columns: 100px 1fr;
      gap: 30px;
      padding: 25px 0;
      border-bottom: 1px solid #ddcfc2;
    }

    .timeline-time {
      color: #a1816d;
      font-size: 17px;
      font-weight: bold;
    }

    .timeline-text h3 {
      font-size: 20px;
      font-weight: 400;
      margin-bottom: 7px;
      color: #5d4b40;
    }

    .timeline-text p {
      color: #806d61;
      font-size: 14px;
    }

    /* =========================
       COUNTDOWN
    ========================= */

    .countdown {
      text-align: center;
      background: #5f5148;
      color: white;
    }

    .countdown .section-title {
      color: #fffaf5;
      margin-bottom: 45px;
    }

    .counter {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      max-width: 650px;
      margin: auto;
      gap: 10px;
    }

    .counter-item {
      padding: 20px 5px;
    }

    .counter-number {
      display: block;
      font-size: clamp(35px, 8vw, 60px);
      font-weight: 300;
    }

    .counter-label {
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      opacity: .7;
    }

    /* =========================
       RSVP
    ========================= */

    .rsvp {
      background: #fffaf5;
      text-align: center;
    }

    .rsvp p {
      max-width: 600px;
      margin: -30px auto 40px;
      color: #806d61;
      line-height: 1.8;
    }

    .rsvp-form {
      max-width: 550px;
      margin: auto;
      display: grid;
      gap: 15px;
    }

    .rsvp-form input,
    .rsvp-form textarea {
      width: 100%;
      border: 1px solid #dfd0c3;
      background: #fff;
      padding: 17px;
      outline: none;
      color: #5e4d42;
    }

    .rsvp-form textarea {
      min-height: 110px;
      resize: vertical;
    }

    .rsvp-form input:focus,
    .rsvp-form textarea:focus {
      border-color: #a98b77;
    }

    .rsvp-btn {
      border: none;
      background: #705d51;
      color: #fff;
      padding: 17px;
      cursor: pointer;
      letter-spacing: 2px;
      transition: .3s;
    }

    .rsvp-btn:hover {
      background: #55453c;
      transform: translateY(-2px);
    }

    /* =========================
       MUSIC
    ========================= */

    .music {
      position: fixed;
      right: 18px;
      bottom: 18px;
      z-index: 1000;
    }

    .music-btn {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,.5);
      background: rgba(93,75,64,.85);
      color: white;
      cursor: pointer;
      backdrop-filter: blur(10px);
      box-shadow: 0 8px 25px rgba(0,0,0,.15);
    }

    .music-btn.playing {
      animation: musicPulse 1.5s infinite;
    }

    @keyframes musicPulse {
      50% {
        transform: scale(1.08);
      }
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      padding: 70px 20px;
      text-align: center;
      background: #f4ebe2;
      color: #806d61;
    }

    footer .names {
      font-family: cursive;
      font-size: 38px;
      color: #625046;
      margin-bottom: 15px;
    }

    footer p {
      font-size: 12px;
      letter-spacing: 2px;
    }

    /* =========================
       ANIMATION
    ========================= */

    .reveal {
      opacity: 0;
      transform: translateY(35px);
      transition: opacity .9s ease, transform .9s ease;
    }

    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    @media (max-width: 650px) {
      section {
        padding: 75px 18px;
      }

      .hero h1 {
        letter-spacing: -2px;
      }

      .details-grid {
        grid-template-columns: 1fr;
      }

      .photo-frame {
        height: 560px;
      }

      .timeline-item {
        grid-template-columns: 70px 1fr;
        gap: 18px;
      }

      .counter {
        gap: 0;
      }

      .counter-number {
        font-size: 35px;
      }

      .counter-label {
        font-size: 8px;
      }
    }
  </style>
</head>

<body>

  <!-- =========================
       ENVELOPE INTRO
  ========================= -->

  <div class="intro" id="intro">

    <div class="envelope-wrap">

      <div class="envelope" id="envelope">

        <div class="envelope-back"></div>

        <div class="letter">
          <div class="letter-content">
            <div class="letter-small">Үйлөнүү тою</div>
            <div class="letter-names">Азамат & Элиза</div>
          </div>
        </div>

        <div class="flap"></div>

      </div>

      <div class="intro-text">
        Конвертти ачуу үчүн басыңыз
      </div>

    </div>

  </div>


  <!-- =========================
       MAIN WEBSITE
  ========================= -->

  <main id="main">

    <!-- HERO -->

    <section class="hero">

      <div class="flower top-left"><span></span></div>
      <div class="flower top-right"><span></span></div>

      <div class="hero-inner reveal">

        <div class="eyebrow">
          Биздин өзгөчө күн
        </div>

        <h1>
          Азамат
          <span>&</span>
          Элиза
        </h1>

        <div class="hero-date">
          16 · 10 · 2026
        </div>

        <div class="scroll-down">
          <span>Төмөн жылдырыңыз</span>
          <div class="scroll-line"></div>
        </div>

      </div>

    </section>


    <!-- PHOTO -->

    <section class="photo-section">

      <div class="container">

        <div class="photo-frame reveal">

          <div class="photo-placeholder">
            <div>
              <div style="font-size:42px; margin-bottom:12px;">А & Э</div>
              <div>
                Бул жерге жаш жубайлардын<br>
                сүйүктүү сүрөтүн коюңуз
              </div>
            </div>
          </div>

        </div>

      </div>

    </section>


    <!-- MESSAGE -->

    <section class="message">

      <div class="flower bottom-left"><span></span></div>
      <div class="flower bottom-right"><span></span></div>

      <div class="container reveal">

        <div class="ornament">❦</div>

        <h2>
          Биздин кубанычыбызды<br>
          сиз менен бөлүшкүбүз келет
        </h2>

        <p>
          Өмүрүбүздүн эң маанилүү күндөрүнүн биринде
          сизди жаныбыздан көрүү биз үчүн чоң бакыт.
          Сүйүүбүздүн жаңы барагын ачкан бул өзгөчө
          күнүбүзгө кош келип, ак тилегиңизди
          арнап кетишиңизди каалайбыз.
        </p>

      </div>

    </section>


    <!-- DETAILS -->

    <section class="details">

      <div class="container">

        <h2 class="section-title reveal">
          Тойубуздун дареги
        </h2>

        <div class="details-grid">

          <div class="detail-card reveal">
            <div class="detail-icon">♡</div>
            <h3>Күнү</h3>
            <p>
              16-октябрь<br>
              2026-жыл
            </p>
          </div>

          <div class="detail-card reveal">
            <div class="detail-icon">◷</div>
            <h3>Башталышы</h3>
            <p>
              Саат<br>
              17:00
            </p>
          </div>

          <div class="detail-card reveal">
            <div class="detail-icon">⌖</div>
            <h3>Дареги</h3>
            <p>
              «Ак Сарай»<br>
              рестораны
            </p>
          </div>

          <div class="detail-card reveal">
            <div class="detail-icon">✦</div>
            <h3>Шаар</h3>
            <p>
              Раззаков<br>
              шаары
            </p>
          </div>

        </div>

      </div>

    </section>


    <!-- PROGRAM -->

    <section class="program">

      <div class="container">

        <h2 class="section-title reveal">
          Тойдун программасы
        </h2>

        <div class="timeline">

          <div class="timeline-item reveal">
            <div class="timeline-time">17:00</div>
            <div class="timeline-text">
              <h3>Конокторду тосуп алуу</h3>
              <p>Сиздерди кубаныч менен күтөбүз.</p>
            </div>
          </div>

          <div class="timeline-item reveal">
            <div class="timeline-time">18:00</div>
            <div class="timeline-text">
              <h3>Тойдун башталышы</h3>
              <p>Салтанаттуу кечебиз башталат.</p>
            </div>
          </div>

          <div class="timeline-item reveal">
            <div class="timeline-time">19:00</div>
            <div class="timeline-text">
              <h3>Куттуктоолор</h3>
              <p>Жакшы каалоо-тилектер жана белектер.</p>
            </div>
          </div>

          <div class="timeline-item reveal">
            <div class="timeline-time">20:00</div>
            <div class="timeline-text">
              <h3>Майрамдык кече</h3>
              <p>Музыка, бий жана жагымдуу көз ирмемдер.</p>
            </div>
          </div>

        </div>

      </div>

    </section>


    <!-- COUNTDOWN -->

    <section class="countdown">

      <div class="container reveal">

        <h2 class="section-title">
          Биздин күнгө чейин
        </h2>

        <div class="counter">

          <div class="counter-item">
            <span class="counter-number" id="days">00</span>
            <span class="counter-label">Күн</span>
          </div>

          <div class="counter-item">
            <span class="counter-number" id="hours">00</span>
            <span class="counter-label">Саат</span>
          </div>

          <div class="counter-item">
            <span class="counter-number" id="minutes">00</span>
            <span class="counter-label">Мүнөт</span>
          </div>

          <div class="counter-item">
            <span class="counter-number" id="seconds">00</span>
            <span class="counter-label">Секунда</span>
          </div>

        </div>

      </div>

    </section>


    <!-- RSVP -->

    <section class="rsvp">

      <div class="container">

        <h2 class="section-title reveal">
          Сизди күтөбүз
        </h2>

        <p class="reveal">
          Тойго катыша турганыңызды алдын ала билдирип коюңуз.
          Сиздин келишиңиз биз үчүн чоң кубаныч!
        </p>

        <form class="rsvp-form reveal" id="rsvpForm">

          <input
            type="text"
            id="guestName"
            placeholder="Атыңыз"
            required
          />

          <input
            type="tel"
            id="guestPhone"
            placeholder="Телефон номери"
          />

          <textarea
            id="guestMessage"
            placeholder="Каалоо-тилегиңиз..."
          ></textarea>

          <button class="rsvp-btn" type="submit">
            КАТЫШАМЫН ♡
          </button>

        </form>

      </div>

    </section>


    <!-- FOOTER -->

    <footer>

      <div class="names">
        Азамат & Элиза
      </div>

      <p>
        16 · 10 · 2026
      </p>

      <p style="margin-top:18px; opacity:.65;">
        Сүйүү менен башталган жаңы жашоо
      </p>

    </footer>

  </main>


  <!-- =========================
       MUSIC
  ========================= -->

  <div class="music">

    <audio
      id="weddingMusic"
      loop
      preload="auto"
    >
      <source
        src="zarlyk-kambaraliev-ajjganysh-abdieva-dalildejjbiz 2.mp3"
        type="audio/mpeg"
      />
    </audio>

    <button
      class="music-btn"
      id="musicBtn"
      aria-label="Музыканы башкаруу"
    >
      ♪
    </button>

  </div>


  <script>

    /* =========================
       ENVELOPE
    ========================= */

    const intro = document.getElementById("intro");
    const envelope = document.getElementById("envelope");
    const main = document.getElementById("main");
    const music = document.getElementById("weddingMusic");
    const musicBtn = document.getElementById("musicBtn");

    let opened = false;

    envelope.addEventListener("click", () => {

      if (opened) return;

      opened = true;

      envelope.classList.add("open");

      setTimeout(() => {

        intro.classList.add("hidden");
        main.classList.add("visible");

        startMusic();

        setTimeout(() => {
          revealElements();
        }, 500);

      }, 1300);

    });


    /* =========================
       MUSIC
    ========================= */

    function startMusic() {

      music.volume = 0.45;

      music.play()
        .then(() => {
          musicBtn.classList.add("playing");
          musicBtn.textContent = "♫";
        })
        .catch(() => {
          musicBtn.classList.remove("playing");
          musicBtn.textContent = "♪";
        });

    }

    musicBtn.addEventListener("click", () => {

      if (music.paused) {

        music.play();

        musicBtn.classList.add("playing");
        musicBtn.textContent = "♫";

      } else {

        music.pause();

        musicBtn.classList.remove("playing");
        musicBtn.textContent = "♪";

      }

    });


    /* =========================
       SCROLL REVEAL
    ========================= */

    function revealElements() {

      const elements =
        document.querySelectorAll(".reveal");

      elements.forEach(el => {

        const rect =
          el.getBoundingClientRect();

        if (rect.top <
            window.innerHeight * 0.88) {

          el.classList.add("active");

        }

      });

    }

    window.addEventListener(
      "scroll",
      revealElements
    );


    /* =========================
       COUNTDOWN
    ========================= */

    const weddingDate =
      new Date("2026-10-16T17:00:00+06:00");

    function updateCountdown() {

      const now = new Date();

      const difference =
        weddingDate.getTime() - now.getTime();

      if (difference <= 0) {

        document.getElementById("days").textContent = "00";
        document.getElementById("hours").textContent = "00";
        document.getElementById("minutes").textContent = "00";
        document.getElementById("seconds").textContent = "00";

        return;

      }

      const days =
        Math.floor(
          difference / (1000 * 60 * 60 * 24)
        );

      const hours =
        Math.floor(
          (difference / (1000 * 60 * 60)) % 24
        );

      const minutes =
        Math.floor(
          (difference / (1000 * 60)) % 60
        );

      const seconds =
        Math.floor(
          (difference / 1000) % 60
        );

      document.getElementById("days").textContent =
        String(days).padStart(2, "0");

      document.getElementById("hours").textContent =
        String(hours).padStart(2, "0");

      document.getElementById("minutes").textContent =
        String(minutes).padStart(2, "0");

      document.getElementById("seconds").textContent =
        String(seconds).padStart(2, "0");

    }

    updateCountdown();

    setInterval(updateCountdown, 1000);


    /* =========================
       RSVP
    ========================= */

    const form =
      document.getElementById("rsvpForm");

    form.addEventListener("submit", (event) => {

      event.preventDefault();

      const name =
        document.getElementById("guestName").value.trim();

      if (!name) return;

      alert(
        `Рахмат, ${name}! ❤️\n\n` +
        `Сиздин жоопуңуз кабыл алынды.`
      );

      form.reset();

    });


    /* =========================
       PREVENT AUDIO ERRORS
    ========================= */

    music.addEventListener(
      "error",
      () => {

        musicBtn.textContent = "♪";
        musicBtn.classList.remove("playing");

      }
    );

  </script>

</body>
</html>
